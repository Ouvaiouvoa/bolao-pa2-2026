{
  "name": "core-motion-factory",
  "version": "1.0.0",
  "private": true,
  "description": "CORE Motion Factory \u2014 linha de produ\u00e7\u00e3o audiovisual multiagente governada. by HAXIS Core",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node infra/scripts/dev.mjs",
    "dev:web": "npm run dev -w @cmf/web",
    "dev:worker": "npm run dev -w @cmf/worker",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck -w @cmf/web",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:visual": "vitest run --project visual",
    "test:visual:update": "CMF_UPDATE_SNAPSHOTS=1 vitest run --project visual",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts --trace off",
    "build": "npm run build -w @cmf/web",
    "start:web": "npm run start -w @cmf/web",
    "start:worker": "npm run start -w @cmf/worker",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle.config.ts",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "db:seed": "tsx infra/scripts/seed.ts",
    "models:install": "bash infra/scripts/install-models.sh",
    "fixture:generate": "tsx infra/scripts/make-fixture.ts",
    "remotion:preview": "npm run studio -w @cmf/renderer",
    "remotion:render:fixture": "tsx apps/renderer/src/cli/render-fixture.ts",
    "pipeline:fixture": "tsx infra/scripts/run-fixture-pipeline.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.5.0",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vitest": "3.2.4",
    "@types/pg": "8.15.6"
  }
}
