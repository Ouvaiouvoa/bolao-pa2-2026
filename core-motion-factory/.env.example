# ── CORE Motion Factory — configuração (sem segredos reais neste arquivo) ──

# Banco e fila
DATABASE_URL=postgres://cmf:cmf@localhost:5432/cmf
REDIS_URL=redis://localhost:6379/0

# URL pública do app web (usada para URLs assinadas e cookies)
CMF_PUBLIC_URL=http://localhost:3000
# Segredo para assinar URLs de arquivos e partes de upload (>= 32 caracteres aleatórios)
CMF_STORAGE_SIGNING_SECRET=troque-por-um-segredo-aleatorio-de-32-ou-mais-caracteres
# Segredo para cookies de sessão
CMF_SESSION_SECRET=troque-por-outro-segredo-aleatorio-de-32-ou-mais-caracteres

# Diretório de dados locais (storage local, cache, bundle do Remotion)
CMF_DATA_DIR=./.data

# Storage: local | s3
CMF_STORAGE_DRIVER=local
# CMF_S3_BUCKET=cmf-media
# CMF_S3_REGION=us-east-1
# CMF_S3_ENDPOINT=http://localhost:9000
# CMF_S3_FORCE_PATH_STYLE=true
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY: definir no cofre de variáveis do ambiente

# Transcrição: sherpa-local (on-premise, padrão) | openai (externo — requer política da organização)
CMF_ASR_PROVIDER=sherpa-local
CMF_MODELS_DIR=./.models
# OPENAI_API_KEY= (somente via cofre de variáveis)

# Modelos de linguagem para agentes (opcional). Sem chave, os agentes usam o motor determinístico heuristic-v1.
# ANTHROPIC_API_KEY= (somente via cofre de variáveis)
CMF_LLM_MODEL=claude-opus-5-5
CMF_LLM_MODEL_SMALL=claude-haiku-5-5

# Render
# Caminho do Chrome headless usado pelo Remotion (vazio = download automático do Remotion)
CMF_CHROME_EXECUTABLE=
CMF_RENDER_CONCURRENCY=2
# Custo estimado de computação de render (centavos de US$ por minuto de vídeo renderizado)
CMF_RENDER_CENTS_PER_MINUTE=4

# Observabilidade
CMF_LOG_LEVEL=info
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
